# Copy to .env.local and fill in. .env.local is gitignored.
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Only the anon (public) key belongs here. The service_role key must NEVER be
# put in a VITE_ variable — Vite inlines those into the JavaScript bundle.

# Local WhatsApp bridge (npm run whatsapp-server). Removed in Phase 6.
VITE_WHATSAPP_BRIDGE_URL=http://localhost:3001
